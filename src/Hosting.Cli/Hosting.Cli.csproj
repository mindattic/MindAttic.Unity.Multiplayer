<Project Sdk="Microsoft.NET.Sdk">

  <!--
    mp-host (UM-T25): the one deploy pipeline every hosting profile reuses: build the UM-T23
    server package, push its Docker image to GHCR, provision the host (IProvisioner per
    provider), run the container + rendezvous, open the firewall, health-check, wait for the
    self-registered join code, and print it. Also status / logs / update / destroy.

    No third-party CLI framework: System.CommandLine is still prerelease (3.0.0-rc at the time
    this shipped) and Spectre.Console.Cli's interactive-menu defaults are overkill for a
    scriptable ops tool whose commands are five flat verbs. Cli/ArgumentReader is a small,
    fully unit-testable hand-rolled parser instead.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>mp-host</AssemblyName>
    <RootNamespace>Unity.Multiplayer.Hosting.Cli</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      UM-T58: installable as a .NET global tool so a game needs neither this repo nor a script of its own:
      `powershell -File tools/install-mp-host.ps1` packs it into C:\LocalNuGet and installs `mp-host` on PATH
      (dotnet tool install -g MindAttic.Unity.Multiplayer.Hosting.Cli add-source C:\LocalNuGet).
      HOUSE-LAW-1: whole-number versions only; bump the major.
    -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mp-host</ToolCommandName>
    <PackageId>MindAttic.Unity.Multiplayer.Hosting.Cli</PackageId>
    <Version>1.0.0</Version>
    <Authors>MindAttic</Authors>
    <Description>mp-host: build and deploy any Unity.Multiplayer game's dedicated server (Local Docker, a VPS, RunPod or a cloud provider) with no per-game script.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MindAttic.Vault" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Unity.Multiplayer.Hosting.Cli.Tests" />
  </ItemGroup>

</Project>

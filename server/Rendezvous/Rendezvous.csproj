<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The self-hosted rendezvous service (RFC 0001): maps a join code to a dedicated server's IP:port.
    Codes come from Core's JoinCode format; Core is referenced through Core.Build, which compiles
    Runtime/Core exactly as Unity does, so the server and the game share one code format.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MindAttic.Unity.Multiplayer.Rendezvous</AssemblyName>
    <RootNamespace>MindAttic.Unity.Multiplayer.Rendezvous</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tests\Core.Build\Core.Build.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MindAttic.Unity.Multiplayer.Rendezvous.Tests" />
  </ItemGroup>

</Project>

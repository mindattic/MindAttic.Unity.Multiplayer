{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Rendezvous": {
    "RegistrationSecret": "",
    "AllowOpenRegistration": false,
    "TtlSeconds": 60,
    "CodeDataLength": 8,
    "MaxRegistrations": 10000,
    "SweepIntervalSeconds": 15,
    "RateLimits": {
      "WindowSeconds": 60,
      "RegisterPerWindow": 10,
      "HeartbeatPerWindow": 120,
      "ResolvePerWindow": 60
    },
    "UseForwardedHeaders": false,
    "KnownProxies": [],
    "RequireHttps": false
  }
}
